{
  "manifest_version": 3,
  "name": "Mercurio",
  "version": "0.7.3",
  "description": "Traduce in italiano i fumetti in inglese e giapponese mentre li leggi: legge le scritte sul tuo PC e traduce con Ollama.",
  "icons": { "16": "icone/16.png", "32": "icone/32.png", "48": "icone/48.png", "128": "icone/128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icone/16.png", "32": "icone/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "offscreen", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
